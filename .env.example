# Template only. Copy to .env.local (gitignored) for local dev, and set the real
# values in Vercel Project Settings -> Environment Variables for production.
#
# THIS FILE IS COMMITTED TO GIT. Never put a real secret here, placeholders only.
#
# Everything is optional: the site builds and runs without any of it. Each
# feature activates once its key is present.

# --- Stripe (private pricing page -> checkout) ---
# Secret key (server-only, NEVER prefixed NEXT_PUBLIC). From Stripe -> Developers -> API keys.
STRIPE_SECRET_KEY=
# Monthly recurring price IDs (start with "price_") for each published tier.
STRIPE_PRICE_CONVERT=
STRIPE_PRICE_GROW=
# Optional one-time setup-fee price IDs, if billed via Stripe.
STRIPE_SETUP_CONVERT=
STRIPE_SETUP_GROW=
# Signing secret for the Stripe webhook (starts with "whsec_").
# From Stripe -> Developers -> Webhooks -> your endpoint.
STRIPE_WEBHOOK_SECRET=

# --- Supabase (first-party data: leads, subscriptions) ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# SECRET / service-role key (server-only, bypasses RLS). NEVER prefix NEXT_PUBLIC.
# From Supabase -> Project Settings -> API Keys -> Secret keys.
SUPABASE_SERVICE_ROLE_KEY=

# --- Transactional email (Resend): welcome emails and client notifications ---
# Supabase still sends the auth emails (invite, password reset, confirm
# sign-up). This is for everything we send ourselves. Without a key those
# emails are skipped and logged as "queued" in client_notifications, and
# nothing else breaks.
# Create a key at https://resend.com/api-keys after verifying the sending
# domain at https://resend.com/domains.
RESEND_API_KEY=
# From header. Its domain must be the verified one. Default: "Tekmadev <hi@tekmadev.com>".
MAIL_FROM=

# --- Admin dashboard (Supabase email/password auth at /admin) ---
# Browser auth client. Same project URL, plus the PUBLISHABLE key (safe to expose).
# From Supabase -> Project Settings -> API Keys -> Publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated emails allowed into /admin. Empty = nobody (fails closed).
# Also disable public sign-ups in Supabase -> Authentication -> Providers -> Email.
ADMIN_EMAILS=

# --- Client portal (account.tekmadev.com) ---
# Optional override of the portal origin used in invite / reset emails and
# redirects. Defaults to https://account.tekmadev.com in production and
# http://account.localhost:3000 in development. Set it on Vercel preview
# deployments if you want portal emails to point at the preview.
NEXT_PUBLIC_PORTAL_URL=

# --- Cal.com webhook ---
# Shared secret you set when creating the webhook in Cal. Verifies the
# X-Cal-Signature-256 HMAC. Leave blank to skip verification (not recommended).
CAL_WEBHOOK_SECRET=

# --- CRM sync (GoHighLevel) ---
# Optional, and setting these is not the same as switching the sync on. The
# three switches (outbound, inbound, reconcile) live in the database and start
# off, so a token on its own changes nothing until the owner arms it in
# Admin -> CRM sync. Leads and subscribers are always stored first-party in
# Supabase either way.
#
# Sub-account Private Integration Token, from GHL -> Settings -> Private
# Integrations. Static, never expires, and rotated from that same screen. It is
# the only credential we call the API with, and it travels in the Authorization
# header, never in a URL, so it cannot land in a log.
GHL_PIT_TOKEN=
# The sub-account (location) id the token belongs to. Every call is scoped to
# it, so a token and an id from two different sub-accounts 404 on everything.
GHL_LOCATION_ID=
# Optional. Overrides the Ed25519 public key that inbound webhooks are verified
# against. GHL's documented key is compiled in on purpose: inbound has to fail
# closed, and a blank env var must not leave the door open. Set this only if
# they rotate that key.
GHL_WEBHOOK_PUBLIC_KEY=
# The private webhook app's client key (Marketplace developer portal > your app
# > Manage > Secrets > Client Keys). Used once per install, by
# /api/crm/oauth/callback, to finish the install; the token it gets back is
# thrown away because the site never calls the API as the app. Without these
# two, installing the app cannot complete, and inbound unsubscribes and client
# appointments never arrive.
GHL_APP_CLIENT_ID=
GHL_APP_CLIENT_SECRET=

# Meta (Facebook / Instagram) ad tracking. All of it is off for a visitor until
# they accept advertising cookies in the banner.
#
# The pixel id is public and already set in config/site.ts; override it here
# only to point at a different dataset.
NEXT_PUBLIC_META_PIXEL_ID=
# Secret. Events Manager > your dataset > Settings > Conversions API > Generate
# access token. Without it the browser pixel still works, but bookings and
# purchases are not reported from the server.
META_CAPI_ACCESS_TOKEN=
# Optional, for testing only. Events Manager > Test events gives a code like
# TEST12345; while set, server events show up in that tab. Remove when done.
META_TEST_EVENT_CODE=
# Optional. Set to 1 to let the pixel run on localhost while testing.
NEXT_PUBLIC_META_PIXEL_DEBUG=
